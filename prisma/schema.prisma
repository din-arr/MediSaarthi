generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PHARMACIST
  STORE_STAFF
  OPS
}

enum Schedule {
  OTC
  H
  H1
  X
}

enum OrderStatus {
  DRAFT
  AWAITING_PHARMACIST
  REUPLOAD_REQUESTED
  APPROVED
  REJECTED
  PARTIAL
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REUPLOAD_REQUESTED
  REJECTED
}

model User {
  id                    String                  @id @default(cuid())
  phone                 String                  @unique
  role                  UserRole
  name                  String?
  preferredLanguage     String                  @default("en")
  registrationNumber    String?
  storeId               String?
  store                 Store?                  @relation("StoreStaff", fields: [storeId], references: [id])
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  familyMembers         FamilyMember[]          @relation("FamilyMemberOwner")
  prescriptions         Prescription[]          @relation("PrescriptionUploader")
  approvals             Approval[]              @relation("PharmacistApprovals")
  itemDecisions         OrderItem[]             @relation("ItemDecisions")
  verifiedOrders        Order[]                 @relation("OrderVerifier")
  h1Entries             H1RegisterEntry[]       @relation("H1Pharmacist")
  auditLogs             AuditLog[]
  notifications         Notification[]
  prescriptionAccessLog PrescriptionAccessLog[]
  orders                Order[]                 @relation("CustomerOrders")
  refills               Refill[]
  addresses             Address[]
}

model FamilyMember {
  id          String    @id @default(cuid())
  name        String
  relation    String
  dateOfBirth DateTime?
  userId      String
  owner       User      @relation("FamilyMemberOwner", fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]   @relation("FamilyMemberOrders")
  addresses   Address[]
  refills     Refill[]
  createdAt   DateTime  @default(now())
}

model Product {
  id              String            @id @default(cuid())
  code            String            @unique @default("PRODUCT")
  name            String
  strength        String
  packSize        String
  form            String
  schedule        Schedule
  price           Decimal
  isBrand         Boolean           @default(false)
  genericOfId     String?
  genericOf       Product?          @relation("Generics", fields: [genericOfId], references: [id])
  brands          Product[]         @relation("Generics")
  suggestedIn     OrderItem[]       @relation("SuggestedGeneric")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  stock           Stock[]
  orderItems      OrderItem[]
  refills         Refill[]
  registerEntries H1RegisterEntry[]

  @@unique([name, strength, packSize])
}

model Store {
  id               String   @id @default(cuid())
  code             String   @unique @default("STORE")
  name             String
  area             String   @unique
  pincode          String   @default("700001")
  lat              Float
  lng              Float
  openHours        String   @default("08:00-22:00")
  phone            String   @default("+91 90000 00000")
  deliveryRadiusKm Float    @default(8)
  stock            Stock[]
  orders           Order[]
  staff            User[]   @relation("StoreStaff")
  createdAt        DateTime @default(now())
}

model Pincode {
  id        String    @id @default(cuid())
  code      String    @unique
  area      String    @default("Kolkata")
  lat       Float
  lng       Float
  addresses Address[]
}

model Address {
  id              String        @id @default(cuid())
  userId          String
  familyMemberId  String?
  label           String
  recipientName   String
  phone           String
  line1           String
  line2           String
  area            String
  city            String
  pincode         String
  lat             Float
  lng             Float
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember    FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  pin             Pincode       @relation(fields: [pincode], references: [code])
  orders          Order[]

  @@index([userId, familyMemberId])
}

model Stock {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  qty       Int      @default(0)
  date      DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, date])
  @@index([storeId, productId])
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique
  customerId     String
  familyMemberId String?
  storeId        String?
  addressId      String?
  deliveryLat    Float?
  deliveryLng    Float?
  routingReason  String?
  missingItems   Json?
  status         OrderStatus   @default(DRAFT)
  total          Decimal
  verifiedById   String?
  verifiedAt     DateTime?
  decisionReason String?
  paymentMethod  String?
  paymentStatus  String        @default("UNPAID")
  paymentRef     String?
  invoiceNumber  String?
  packedAt       DateTime?
  riderName      String?
  handedOverAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       User          @relation("CustomerOrders", fields: [customerId], references: [id])
  familyMember   FamilyMember? @relation("FamilyMemberOrders", fields: [familyMemberId], references: [id])
  store          Store?        @relation(fields: [storeId], references: [id])
  address        Address?      @relation(fields: [addressId], references: [id])
  verifiedBy     User?         @relation("OrderVerifier", fields: [verifiedById], references: [id])
  items          OrderItem[]
  h1Entries      H1RegisterEntry[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  prescription   Prescription?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  channel   String   @default("SMS")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal
  approvalStatus ApprovalStatus @default(PENDING)
  rejectReason   String?
  originalQty    Int?
  suggestedProductId String?
  consentStatus  String         @default("NONE")
  suggestedProduct Product?     @relation("SuggestedGeneric", fields: [suggestedProductId], references: [id])
  decidedById    String?
  decidedAt      DateTime?
  decidedBy      User?          @relation("ItemDecisions", fields: [decidedById], references: [id])
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
}

model Prescription {
  id                String                  @id @default(cuid())
  uploadedById      String
  orderId           String?                 @unique
  encryptedFilePath String
  fileData          Bytes?
  aiDraft           Json?
  status            PrescriptionStatus      @default(PENDING)
  doctorName        String?
  doctorRegNo       String?
  issuedOn          DateTime?
  uploadedAt        DateTime                @default(now())
  uploadedBy        User                    @relation("PrescriptionUploader", fields: [uploadedById], references: [id])
  order             Order?                  @relation(fields: [orderId], references: [id])
  approvals         Approval[]
  accessLogs        PrescriptionAccessLog[]
}

model Approval {
  id             String       @id @default(cuid())
  prescriptionId String
  pharmacistId   String
  timestamp      DateTime     @default(now())
  notes          String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacist     User         @relation("PharmacistApprovals", fields: [pharmacistId], references: [id])
}

model H1RegisterEntry {
  id             String   @id @default(cuid())
  prescriber     String
  prescriberRegNo String  @default("")
  patient        String
  patientAddress String   @default("")
  productId      String
  qty            Int
  orderId        String?
  pharmacistId   String?
  date           DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  order          Order?   @relation(fields: [orderId], references: [id])
  pharmacist     User?    @relation("H1Pharmacist", fields: [pharmacistId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
}

model PrescriptionAccessLog {
  id             String       @id @default(cuid())
  userId         String
  prescriptionId String
  timestamp      DateTime     @default(now())
  action         String
  user           User         @relation(fields: [userId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, timestamp])
}

model Refill {
  id             String   @id @default(cuid())
  customerId     String
  familyMemberId String?
  productId      String
  dosePerDay     Decimal
  lastQty        Int
  nextRunOutDate DateTime
  autoRemind     Boolean  @default(true)
  customer       User     @relation(fields: [customerId], references: [id])
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  product        Product  @relation(fields: [productId], references: [id])
}

model RuleConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model OtpRequest {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}
