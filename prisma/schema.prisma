generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PHARMACIST
  STORE_STAFF
}

enum Schedule {
  OTC
  H
  H1
  X
}

enum OrderStatus {
  DRAFT
  AWAITING_PHARMACIST
  REUPLOAD_REQUESTED
  APPROVED
  REJECTED
  PARTIAL
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REUPLOAD_REQUESTED
  REJECTED
}

model User {
  id                    String                  @id @default(cuid())
  phone                 String                  @unique
  role                  UserRole
  name                  String?
  preferredLanguage     String                  @default("en")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  familyMembers         FamilyMember[]          @relation("FamilyMemberOwner")
  prescriptions         Prescription[]          @relation("PrescriptionUploader")
  approvals             Approval[]              @relation("PharmacistApprovals")
  prescriptionAccessLog PrescriptionAccessLog[]
  orders                Order[]                 @relation("CustomerOrders")
  refills               Refill[]
  addresses             Address[]
}

model FamilyMember {
  id          String    @id @default(cuid())
  name        String
  relation    String
  dateOfBirth DateTime?
  userId      String
  owner       User      @relation("FamilyMemberOwner", fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]   @relation("FamilyMemberOrders")
  createdAt   DateTime  @default(now())
}

model Product {
  id              String            @id @default(cuid())
  code            String            @unique @default("PRODUCT")
  name            String
  strength        String
  packSize        String
  form            String
  schedule        Schedule
  price           Decimal
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  stock           Stock[]
  orderItems      OrderItem[]
  refills         Refill[]
  registerEntries H1RegisterEntry[]

  @@unique([name, strength, packSize])
}

model Store {
  id               String   @id @default(cuid())
  code             String   @unique @default("STORE")
  name             String
  area             String   @unique
  pincode          String   @default("700001")
  lat              Float
  lng              Float
  openHours        String   @default("08:00-22:00")
  deliveryRadiusKm Float    @default(8)
  stock            Stock[]
  orders           Order[]
  createdAt        DateTime @default(now())
}

model Pincode {
  id        String    @id @default(cuid())
  code      String    @unique
  lat       Float
  lng       Float
  addresses Address[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String
  line       String
  pincode    String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin        Pincode  @relation(fields: [pincode], references: [code])
  orders     Order[]
}

model Stock {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  qty       Int      @default(0)
  date      DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, date])
  @@index([storeId, productId])
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique
  customerId     String
  familyMemberId String?
  storeId        String?
  addressId      String?
  deliveryLat    Float?
  deliveryLng    Float?
  routingReason  String?
  missingItems   Json?
  status         OrderStatus   @default(DRAFT)
  total          Decimal
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       User          @relation("CustomerOrders", fields: [customerId], references: [id])
  familyMember   FamilyMember? @relation("FamilyMemberOrders", fields: [familyMemberId], references: [id])
  store          Store?        @relation(fields: [storeId], references: [id])
  address        Address?      @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  prescription   Prescription?
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal
  approvalStatus ApprovalStatus @default(PENDING)
  rejectReason   String?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
}

model Prescription {
  id                String                  @id @default(cuid())
  uploadedById      String
  orderId           String?                 @unique
  encryptedFilePath String
  aiDraft           Json?
  status            PrescriptionStatus      @default(PENDING)
  uploadedAt        DateTime                @default(now())
  uploadedBy        User                    @relation("PrescriptionUploader", fields: [uploadedById], references: [id])
  order             Order?                  @relation(fields: [orderId], references: [id])
  approvals         Approval[]
  accessLogs        PrescriptionAccessLog[]
}

model Approval {
  id             String       @id @default(cuid())
  prescriptionId String
  pharmacistId   String
  timestamp      DateTime     @default(now())
  notes          String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacist     User         @relation("PharmacistApprovals", fields: [pharmacistId], references: [id])
}

model H1RegisterEntry {
  id         String   @id @default(cuid())
  prescriber String
  patient    String
  productId  String
  qty        Int
  date       DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

model PrescriptionAccessLog {
  id             String       @id @default(cuid())
  userId         String
  prescriptionId String
  timestamp      DateTime     @default(now())
  action         String
  user           User         @relation(fields: [userId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, timestamp])
}

model Refill {
  id             String   @id @default(cuid())
  customerId     String
  productId      String
  dosePerDay     Decimal
  lastQty        Int
  nextRunOutDate DateTime
  customer       User     @relation(fields: [customerId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
}

model RuleConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model OtpRequest {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}
